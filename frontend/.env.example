# Django REST API — set BEFORE `npm run build`.
# Leave EMPTY for nginx / Vite same-origin (/api, /media). Required for HTTPS + camera.
# Do NOT set http://SERVER_IP:8000 when the site is served on https://SERVER_IP
VITE_API_BASE_URL=
# Set false to skip ML API calls in the UI (cameras, attendance face, etc.)
VITE_ML_ENABLED=true
