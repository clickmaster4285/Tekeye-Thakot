# ML inference API — copy to .env on Server 2
ML_API_HOST=0.0.0.0
ML_API_PORT=8100
ML_LIVE_STREAM_FPS=30
# Live MJPEG output: 0 = native camera resolution (4K passthrough). Set 3840/2160 to cap.
ML_LIVE_MAX_WIDTH=0
ML_LIVE_MAX_HEIGHT=0
ML_LIVE_JPEG_QUALITY=92
# RTSP decode: ffmpeg (native resolution, recommended) or opencv (legacy)
ML_RTSP_DECODE=ffmpeg
# NVIDIA NVDEC: auto (default), true, or false
ML_RTSP_NVDEC=auto
ML_RTSP_FRAME_BUFFER_SIZE=30
ML_RTSP_NVDEC_HW_FRAMES=8
# RTSP resilience
ML_RTSP_MAX_FAILS=30
ML_RTSP_RECONNECT_SEC=2
ML_RTSP_OPEN_RETRY_SEC=3
# ffmpeg path (optional; auto-detects tools/ffmpeg/bin or PATH)
# FFMPEG_PATH=
ML_DEVICE=0
# GPU: 0 or cuda:0 (default). Set cpu to force CPU-only inference.
ML_YOLO_WEIGHTS=runs/train/stage3_finetune3/weights/yolo26l.pt
ML_YOLO_CUSTOM_WEIGHTS=runs/train/stage3_finetune3/weights/best.pt
ML_YOLO_SMOKE_WEIGHTS=runs/train/stage3_finetune3/weights/best_Smoke_Detection.pt
ML_YOLO_WEAPON_WEIGHTS=runs/train/stage3_finetune3/weights/best_weapon_detection.pt
ML_PLATE_WEIGHTS=runs/train/stage3_finetune3/weights/best_number_plate_detection.pt
ML_YOLO_CONF=0.30
ML_YOLO_IMGSZ=640
ML_YOLO_MAX_DET=200
ML_COCO_MAX_CLASS_ID=79
# COCO detections are filtered to: person, car, truck, bus, motorcycle, backpack,
# handbag, suitcase, cell phone, laptop, knife, bicycle, bench, chair, dining table, bottle.
# Fire/smoke: best_Smoke_Detection.pt | Weapons: best_weapon_detection.pt
ML_SMOKE_FIRE_CONF=0.42
ML_WEAPON_CONF=0.40
# License plate (ANPR) — YOLO plate model + EasyOCR
# Saves under backend/media/licence plates/ (plates/, frames/, captures.csv)
# ML_MEDIA_ROOT=../backend/media
# ML_PLATE_MEDIA_DIR=
ML_PLATE_CONF=0.25
ML_PLATE_MIN_OCR_CONF=0.25
ML_PLATE_MIN_DET_CONF=0.20
ML_PLATE_MIN_LEN=4
ML_PLATE_SAVE_INTERVAL=8
ML_PLATE_OCR_EVERY=1
ML_PLATE_IMGSZ=1280
# false = only cameras with purpose=anpr; true = all live cameras
ML_PLATE_ON_ALL=true
